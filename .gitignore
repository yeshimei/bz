node_modules/
*.log
*.stackdump
.pi-subagents/
# vitest 模组转译的临时文件（根目录 _tmp_<pid>_<hash>，零字节），跑测试时反复出现
_tmp_*


coverage/
viz/
.scratch/
# Release 资产的扁平化暂存目录（push-assets 自己建、跑完自己删；万一中断别进库）
.release-upload/
# pack-release 的打包暂存目录（同样自己建、跑完自己删；中断时会把整份下载夹留在这里）
.pack-tmp/
.dsh-worktrees/
.zcode/
# ZCode 自己生成的排除清单（内容随编辑器同步，属于本机配置）
.zcodeignore
.workbuddy/
# 增量跑测试的结果缓存（按文件复用上次成功结果；本轮通过即写回）
.bz-test-cache/
# tsc --noEmit 的增量编译缓存（tsconfig.json 的 incremental；每棵工作树各一份）
/tsconfig.tsbuildinfo

# bz-face vendor 运行日志（logger.py 以 __file__ 锚定，落在 vendor 内，不入 git）
tools/obsidian-face/python/vendor/WeChatMsg_Lite/logs/

# GitHub Release 打包产物（本地临时，随 Release 上传，不入库）
bz-*.zip
bz-offline-*.zip
SHA256SUMS.txt
release-note-*.md
# 发版两道闸的状态（scripts/release-gate.mjs 写；每次发版重新过目，不入库）
.bz-release-gate.json

# 功能计数端点（本机私有；仓库源码里只有空值，真实值由构建时读这份文件注入）
usage.local.json
# 看板产物（脚本默认落 .scratch，这里兜底）
usage-report.html
# 本机凭证（万一被误拷进仓库）
.bz-usage-key
.bz-pat
