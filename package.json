{
  "name": "bz",
  "version": "1.36.0",
  "description": "装在笔记库里的个人管理插件：日记、备忘、读书观影、复习、密码，21 个模块共用一个首页，数据只存本地。",
  "main": "src/main.ts",
  "author": "叫我包仔",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeshimei/bz.git"
  },
  "bugs": {
    "url": "https://github.com/yeshimei/bz/issues"
  },
  "homepage": "https://github.com/yeshimei/bz#readme",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "changelog": "node scripts/_gen-changelog.mjs",
    "skin-pack": "node scripts/build-skin-pack.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "tools-pack": "node scripts/build-tools-pack.mjs",
    "rss-upstream": "node scripts/rss-catalog/fetch-upstream.mjs",
    "rss-catalog": "node scripts/rss-catalog/build.mjs",
    "cinema-index": "node scripts/build-cinema-index.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "split-skins": "node scripts/split-domain-skins.mjs",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:dom": "node scripts/test-domain.mjs",
    "test:affected": "node scripts/test-affected.mjs",
    "test:changed": "node scripts/test-affected.mjs --since master",
    "test:changed:vitest": "node node_modules/vitest/vitest.mjs run --changed master",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage --maxWorkers=2",
    "assets": "node scripts/push-assets.mjs",
    "release-steps": "node scripts/release-steps.mjs",
    "pack-release": "node scripts/pack-release.mjs",
    "pre-review": "node scripts/pre-release-review.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "pkm",
    "note-taking",
    "diary",
    "todo",
    "spaced-repetition",
    "pomodoro"
  ],
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.21.5",
    "jsdom": "^30.0.1",
    "moment": "^2.30.1",
    "obsidian": "latest",
    "typescript": "^5.4.5",
    "vitest": "^5.0.3"
  }
}
