{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowJs": true,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    // 只重查变更文件及其依赖者（缓存 = 根目录 tsconfig.tsbuildinfo，已入 .gitignore）
    "incremental": true,
    "lib": ["DOM", "DOM.Iterable", "ES5", "ES6", "ES7", "ES2018", "ES2019", "ES2020", "ES2021", "ES2022"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "prototypes/**/*.ts"]
}
