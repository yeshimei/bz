{
  "name": "@jwbz/bili-downloader",
  "version": "1.1.2",
  "description": "B站下载器——独立 NodeJS Web 工具：启动本地服务并打开网页，在网页内完成 B站视频解析、分批/分P 选择、下载（多 CDN 节点切换）、多段落剪辑（分开/合并交付）、压缩（ffmpeg，产物 ffprobe 校验兜底）、转文字（faster-whisper）与交付（移入交付目录 + 剪贴板 wikilink）",
  "main": "server.js",
  "bin": {
    "bili-dl": "cli.js"
  },
  "files": [
    "cli.js",
    "core.js",
    "config.js",
    "server.js",
    "public/"
  ],
  "scripts": {
    "start": "node cli.js",
    "test": "node --test"
  },
  "keywords": [
    "obsidian",
    "bilibili",
    "download",
    "ffmpeg",
    "whisper"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
