{
  "name": "@jwbz/obsidian-news",
  "version": "1.2.0",
  "description": "聚合讯数据源守护——每 30 分钟抓取最近 24 小时文章（果壳科学人 + 知乎日报 + B站 UP 主视频投稿；源开关可控），URL + 标题双去重入库 news.json（六段结构，含 UP 主名字/头像回填、每 UP 最近 N 条总量窗口（窗口外裁剪）与 Cookie 配置），供 Obsidian 阅读",
  "main": "watcher.js",
  "bin": {
    "obsidian-news": "./cli.js"
  },
  "files": [
    "cli.js",
    "watcher.js",
    "test/"
  ],
  "scripts": {
    "start": "node cli.js watch",
    "fetch": "node cli.js fetch",
    "check": "node --check cli.js && node --check watcher.js",
    "test": "node --check cli.js && node --check watcher.js && node --test \"test/*.test.js\""
  },
  "keywords": [
    "obsidian",
    "news",
    "guokr",
    "zhihu",
    "bilibili",
    "fetch",
    "pm2"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
